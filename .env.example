# You do NOT need to edit this file by hand.
# Start the app and paste your keys into the web page — it creates .env for you.
#
# Only if you prefer doing it manually: copy this file to ".env" and fill it in.

TRANSLOADIT_AUTH_KEY=
TRANSLOADIT_AUTH_SECRET=

